{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Arts runtime export",
  "description": "The list of derived, engine-ready files made from a delivered bundle: each file with its hash and the hash of the file it came from. Derived files are never approved and never a source for new art.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "rule",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "runtime"
    },
    "rule": {
      "type": "string",
      "minLength": 1,
      "description": "How the derived pixels were made from the delivered ones."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "sha256",
          "source_path",
          "source_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "sheet",
              "atlas",
              "copied"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
