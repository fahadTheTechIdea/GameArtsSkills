{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Arts Mockups Lifecycle Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "game_id",
    "mockups"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "mockups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mockup_id",
          "revision",
          "scope",
          "status",
          "file",
          "sha256",
          "metadata",
          "settings_sha256",
          "prompt",
          "tool_mode",
          "created_at_utc",
          "approval",
          "visual_review"
        ],
        "properties": {
          "mockup_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^v[0-9]{3,}$"
          },
          "scope": {
            "enum": [
              "world",
              "scene",
              "asset",
              "character",
              "ui_screen",
              "ui_flow",
              "mixed",
              "style"
            ]
          },
          "status": {
            "enum": [
              "generated",
              "approved",
              "revoked"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "metadata": {
            "type": "string",
            "minLength": 1
          },
          "settings_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "tool_mode": {
            "enum": [
              "built_in_image_gen",
              "cli_image_gen",
              "connected_tool",
              "external_import"
            ]
          },
          "tool_name": {
            "type": "string",
            "minLength": 1
          },
          "created_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "approval": {
            "enum": [
              "pending",
              "user_granted",
              "not_granted",
              "rejected"
            ]
          },
          "visual_review": {
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "approval_reference": {
            "type": "string"
          },
          "approved_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "artifact_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          },
          "storyboard_scene_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "provenance": {
            "type": "object",
            "description": "How the artwork was produced (standard: generation provenance).",
            "properties": {
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "seed": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "edit_mode": {
                "type": "string"
              },
              "conditioning_images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-fA-F0-9]{64}$"
                    }
                  }
                }
              },
              "captured_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "rights": {
            "type": "object",
            "description": "Usage-rights note for supplied references and generated art.",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "owned",
                  "licensed",
                  "user_supplied",
                  "unknown"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "replaced_by": {
            "type": "string"
          },
          "revocation_reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
