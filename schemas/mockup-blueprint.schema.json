{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Arts Mockup Blueprint (single maintained schema)",
  "type": "object",
  "required": [
    "schema_version",
    "mockup_id",
    "mockup_revision",
    "approval_status",
    "scope",
    "elements",
    "coverage_audit"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "7.2"
      ],
      "description": "Format marker; 7.2 is accepted on read for existing blueprints."
    },
    "mockup_id": {
      "type": "string",
      "minLength": 1
    },
    "mockup_revision": {
      "type": "string",
      "minLength": 1
    },
    "approval_status": {
      "enum": [
        "approved",
        "pending_approval",
        "revise",
        "rejected"
      ]
    },
    "scope": {
      "enum": [
        "world",
        "scene",
        "asset",
        "character",
        "ui_screen",
        "ui_flow",
        "mixed",
        "style"
      ]
    },
    "subscopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ref": {
      "type": "string"
    },
    "game_profile": {
      "type": "string"
    },
    "style_profile": {
      "type": "string"
    },
    "parent_blueprint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "child_blueprint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "element_id",
          "scope",
          "evidence_status",
          "observed_details",
          "motion_candidates",
          "production_strategy"
        ],
        "properties": {
          "element_id": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_region_px": {
            "type": "array",
            "description": "Actual bounded source-pixel rectangle [x,y,width,height] selected by analyzer; never invented. Round observed fractional coverage outward before reference-crop preparation.",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "coordinate_system": {
            "type": "string"
          },
          "evidence_status": {
            "enum": [
              "observed",
              "user_specified",
              "inferred",
              "unknown"
            ]
          },
          "observed_details": {
            "type": "object"
          },
          "geometry": {
            "type": "object"
          },
          "textures_materials": {
            "type": "object"
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "motion_candidates": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "production_strategy": {
            "type": "string"
          },
          "output_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reference_region_id": {
            "type": "string",
            "description": "Stable region ID for the selected approved mockup revision."
          },
          "reference_padding_px": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256,
            "description": "Context margin around reference crop; never modifies source image."
          },
          "asset_class": {
            "type": "string",
            "description": "Resolved asset class passed to existing reference-crop and production skills."
          },
          "approved_source_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$",
            "description": "Actual approved source image hash; never guessed."
          },
          "reference_packet_path": {
            "type": "string",
            "description": "Existing generated asset candidate's reference/reference.packet.json path when prepared."
          },
          "separation_inventory": {
            "type": "array",
            "description": "Explicit ownership inventory of every detachable, movable, removable, interactive, replaceable or independently animated object observed in this element. Emptiness must be reviewed for composite parents.",
            "items": {
              "type": "object",
              "required": [
                "component_id",
                "ownership",
                "source_evidence"
              ],
              "properties": {
                "component_id": {
                  "type": "string",
                  "minLength": 1
                },
                "ownership": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "movable",
                      "removable",
                      "interactive",
                      "replaceable",
                      "animated",
                      "independent_prop"
                    ]
                  }
                },
                "source_evidence": {
                  "type": "string",
                  "description": "Observed location/visual evidence or user-approved scope"
                },
                "static_parent_action": {
                  "const": "exclude",
                  "description": "Always remove detached component pixels from its parent static artwork"
                },
                "sprite_output_id": {
                  "type": "string"
                },
                "removal_mask_ref": {
                  "type": "string"
                },
                "clean_plate_ref": {
                  "type": "string"
                },
                "visual_status": {
                  "enum": [
                    "pending",
                    "reviewed",
                    "rejected"
                  ]
                }
              }
            }
          },
          "parent_cleanup": {
            "type": "object",
            "description": "Per-view/frame cleanup evidence. Approval requires verifiable parent image removal for every independently separated object, not merely an extra sprite sheet.",
            "properties": {
              "required": {
                "type": "boolean",
                "default": false
              },
              "status": {
                "enum": [
                  "pending",
                  "technical_passed",
                  "visual_reviewed",
                  "rejected",
                  "not_applicable"
                ]
              },
              "clean_plate_reference": {
                "type": "string"
              },
              "cleanup_manifests": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "technical_report": {
                "type": "string"
              }
            }
          },
          "visual_review_evidence": {
            "type": "object",
            "description": "Evidence for independently inspected detached sprites and reconstructed parent background; optional in legacy blueprints, required by skills for new composite production.",
            "properties": {
              "review_protocol": {
                "type": "string",
                "enum": [
                  "review_packet_v1",
                  "legacy"
                ]
              },
              "source_inventory_audit": {
                "type": "string",
                "enum": [
                  "pending",
                  "complete_for_visible_reference",
                  "needs_revision"
                ]
              },
              "expected_component_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "occlusion_audit": {
                "type": "string",
                "enum": [
                  "pending",
                  "completed",
                  "needs_revision"
                ]
              },
              "uncertain_regions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "evidence_status",
                    "reason"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_status": {
                      "enum": [
                        "inferred",
                        "partially_observed",
                        "unknown"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_pixel_mask": {
                      "type": "string",
                      "description": "Binary source-aligned region for human review"
                    }
                  }
                }
              },
              "review_packet_ref": {
                "type": "string",
                "description": "Relative path to candidate visual_review.packet.json"
              },
              "user_decision_ref": {
                "type": "string",
                "description": "Relative path to explicitly user-approved reviewed decision"
              },
              "review_status": {
                "enum": [
                  "pending_user_visual_review",
                  "user_visual_approval_recorded",
                  "needs_revision",
                  "rejected"
                ]
              },
              "approved_source_mockup_id": {
                "type": "string",
                "minLength": 1,
                "description": "Exact approved mockup ID shown as authoritative review source."
              },
              "approved_source_mockup_revision": {
                "type": "string",
                "minLength": 1,
                "description": "Exact approved mockup revision shown as authoritative review source."
              },
              "approved_reference_crop_path": {
                "type": "string",
                "description": "Actual source-grounded approved mockup crop packaged with the current candidate."
              },
              "approved_reference_crop_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$",
                "description": "Hash of the approved reference crop shown on the QA board."
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "coverage_audit": {
      "type": "object",
      "required": [
        "status",
        "unassigned_regions"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "incomplete",
            "pending_review"
          ]
        },
        "unassigned_regions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "intentional_exclusions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
