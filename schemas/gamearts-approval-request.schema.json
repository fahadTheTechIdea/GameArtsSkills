{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Arts approval request",
  "description": "What the owner is asked to approve, as the approval form shows it: a title, a message and a list of items, each with facts and the pictures to look at. The agent writes the first part; the framework fills in approval_id, created_at_utc and each picture's sha256, bytes, width and height when it saves the request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "A short explanation for the owner, shown above the items."
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "mockups",
            "assets",
            "storyboard",
            "settings",
            "restore",
            "other"
          ],
          "description": "What is being approved. mockups, assets, storyboard (a scene), settings and restore are read by the commands that take --approval-id; other is recorded for the agent and approves nothing by itself."
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "maxLength": 80
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "maxLength": 40,
          "description": "The exact revision shown (for settings, the version printed with their summary). A decision approves this revision and no other."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "facts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "value": {
                "type": "string",
                "maxLength": 400
              }
            }
          }
        },
        "images": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "description": "A picture inside the game's folder, relative to it."
              },
              "caption": {
                "type": "string",
                "maxLength": 200
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
